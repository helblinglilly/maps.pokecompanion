{
	"name": "maps-pokecompanion",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.4.2",
	"dependencies": {
		"@vinext/cloudflare": "latest",
		"prismjs": "^1.30.0",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@tailwindcss/postcss": "latest",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "latest",
		"@types/prismjs": "^1.26.6",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"cf": "^1.0.0-beta.20",
		"jsdom": "^29.1.1",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "8.3.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	},
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"deploy": "wrangler deploy",
		"preview": "npm run build && npm run start --",
		"cf-typegen": "wrangler types",
		"predev": "node scripts/sync-maps.ts && node scripts/build-map-catalog.ts && node scripts/build-completeness.ts",
		"prebuild": "node scripts/sync-maps.ts && node scripts/build-map-catalog.ts && node scripts/build-completeness.ts",
		"maps:catalog": "node scripts/sync-maps.ts && node scripts/build-map-catalog.ts",
		"maps:completeness": "npm run maps:catalog && node scripts/build-completeness.ts",
		"release:bundle": "node scripts/bundle-release.ts",
		"maps:readme": "npm run maps:catalog && node scripts/build-completeness.ts --update-readme"
	}
}
